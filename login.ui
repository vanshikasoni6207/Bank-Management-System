  <property name="styleSheet">
   <string notr="true">/* =====================================
   LOGIN WINDOW
   ===================================== */

QMainWindow {
    background-color: #F5F3EF;
}

QWidget {
    background-color: #F5F3EF;
    color: #1F2937;
}


/* =====================================
   LOGIN HEADING
   ===================================== */
QLabel#login
{color:#1F2937;
background-color:transparent;
font-size:26px;
font-weight:bold;

}
QLabel {
    background-color: transparent;
    color: #374151;
    font-size: 13px;
    font-weight: 600;
}


/* =====================================
   LOGIN INPUT FIELDS
   ===================================== */

QLineEdit {
    background-color: #FFFFFF;
    color: #1F2937;

    border: 1px solid #D1D5DB;
    border-radius: 8px;

    padding: 5px;
    font-size: 12px;
}

QLineEdit:hover {
    border: 1px solid #A78BFA;
}

QLineEdit:focus {
    border: 2px solid #7C3AED;
    background-color: #FFFFFF;
}


/* =====================================
   LOGIN BUTTON
   ===================================== */

QPushButton {
    background-color: #7C3AED;
    color: #FFFFFF;

    border: none;
    border-radius: 8px;

    padding: 10px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #6D28D9;
}

QPushButton:pressed {
    background-color: #5B21B6;
}


/* =====================================
   BACK BUTTON
   ===================================== */

QPushButton#backbutton {
    background-color: transparent;
    color: #7C3AED;

    border: none;
    border-radius: 6px;

    padding: 8px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#backbutton:hover {
    background-color: #EDE9FE;
    color: #6D28D9;
}

QPushButton#backbutton:pressed {
    background-color: #DDD6FE;
}</string>
