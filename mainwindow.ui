  <property name="styleSheet">
   <string notr="true">QMainWindow #MainWindow
{
    background-color: #0B0D25;
}

QWidget#centralwidget {
    background-color: #0B0D25;
}

/* =========================================
   ALL LABELS
   ========================================= */

QLabel {
    background-color: transparent;
}

/* =========================================
   BANK SYSTEM TITLE
   ========================================= */

QLabel#mainlabel {
    background-color: transparent;
    color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;;
    font-size: 32px;
    font-weight: 700;
}

/* =========================================
   WELCOME TEXT
   ========================================= */

QLabel#welcomelabel {
    background-color: transparent;
    color: #FFFFFF;
    font-family: &quot;Segoe UI&quot;;
    font-size: 23px;
    font-weight: 600;
}

/* =========================================
   SECURE SIMPLE RELIABLE
   ========================================= */

QLabel#notelabel {
    background-color: transparent;
    color: #9693C5;
    font-family: &quot;Segoe UI&quot;;
    font-size: 16px;
    font-weight: 600;
}

/* =========================================
   CREATE ACCOUNT BUTTON
   ========================================= */

QPushButton#btnCreateAccount {
    background-color: #7140E8;
    color: #FFFFFF;

    border: 1px solid #875CFF;
    border-radius: 18px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 18px;
    font-weight: 700;

    padding: 5px;
}

QPushButton#btnCreateAccount:hover {
    background-color: #8050F5;
    border: 1px solid #A27BFF;
}

QPushButton#btnCreateAccount:pressed {
    background-color: #5E32C9;
}

/* =========================================
   LOGIN BUTTON
   ========================================= */

QPushButton#btnLogin {
    background-color: #7140E8;
    color: #FFFFFF;

    border: 1px solid #875CFF;
    border-radius: 18px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 18px;
    font-weight: 700;

    padding: 5px;
}

QPushButton#btnLogin:hover {
    background-color: #8050F5;
    border: 1px solid #A27BFF;
}

QPushButton#btnLogin:pressed {
    background-color: #5E32C9;
}

/* =========================================
   EXIT BUTTON
   ========================================= */

QPushButton#btnExit {
    background-color: #353653;
    color: #E5E3F2;

    border: 1px solid #4B4C70;
    border-radius: 18px;

    font-family: &quot;Segoe UI&quot;;
    font-size: 18px;
    font-weight: 700;

    padding: 5px;
}

QPushButton#btnExit:hover {
    background-color: #414263;
    border: 1px solid #67688D;
    color: #FFFFFF;
}

QPushButton#btnExit:pressed {
    background-color: #292A45;
}</string>
