  <property name="styleSheet">
   <string notr="true">/* ================================
   CREATE ACCOUNT WINDOW
   ================================ */

QMainWindow {
    background-color: #F5F3EF;
}

QWidget {
    background-color: #F5F3EF;
    color: #1F2937;
}


/* ================================
   TITLE
   ================================ */

QLabel#calabel
 {
    color: #1F2937;
    font-size: 26px;
    font-weight: bold;
    background-color: transparent;
}

/* ================================
   NORMAL LABELS
   ================================ */

QLabel {
    color: #374151;
    font-size: 13px;
    font-weight: 600;
    background-color: transparent;
}


/* ================================
   INPUT FIELDS
   ================================ */

QLineEdit {
    background-color: #FFFFFF;
    color: #1F2937;

    border: 1px solid #D1D5DB;
    border-radius: 8px;

    padding: 5px;
    font-size: 12px;
}

QLineEdit:hover {
    border: 1px solid #A78BFA;
}

QLineEdit:focus {
    border: 2px solid #7C3AED;
    background-color: #FFFFFF;
}


/* ================================
   CREATE ACCOUNT BUTTON
   ================================ */

QPushButton#btncreateaccount {
    background-color: #7C3AED;
    color: #FFFFFF;

    border: none;
    border-radius: 8px;

    padding: 11px;
    font-size: 14px;
    font-weight: bold;
}

QPushButton#btncreateaccount:hover {
    background-color: #6D28D9;
}

QPushButton#btncreateaccount:pressed {
    background-color: #5B21B6;
}


/* ================================
   BACK BUTTON
   ================================ */

QPushButton#btnBack {
    background-color: transparent;
    color: #7C3AED;

    border: none;
    border-radius: 6px;

    padding: 8px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton#btnBack:hover {
    background-color: #EDE9FE;
    color: #6D28D9;
}

QPushButton#btnBack:pressed {
    background-color: #DDD6FE;
}


/* ================================
   OTHER BUTTONS
   ================================ */

QPushButton {
    background-color: #7C3AED;
    color: white;

    border: none;
    border-radius: 8px;

    padding: 10px;
    font-size: 13px;
    font-weight: bold;
}

QPushButton:hover {
    background-color: #6D28D9;
}

QPushButton:pressed {
    background-color: #5B21B6;
}
/* ================================
   ERROR / INFORMATION LABEL
   ================================ */

QLabel#errorLabel {
    color: #DC2626;
    font-size: 12px;
    font-weight: normal;
    background-color: transparent;
}


/* ================================
   SUCCESS LABEL
   ================================ */

QLabel#successLabel {
    color: #16A34A;
    font-size: 12px;
    font-weight: normal;
    background-color: transparent;
}</string>
